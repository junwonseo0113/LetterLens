# Set to true (default) to run fully offline with canned OCI responses.
MOCK_MODE=true

DATABASE_URL=sqlite:///letterlens.db

# Only needed when MOCK_MODE=false (also: .venv/bin/pip install oci).
# Run the server with --env-file .env -- plain uvicorn doesn't read this file.
OCI_CONFIG_PATH=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=
# Must be a Cohere chat model, e.g. cohere.command-a-03-2025
OCI_GENAI_MODEL_ID=
# Overrides the region in the OCI config file
OCI_REGION=us-chicago-1
